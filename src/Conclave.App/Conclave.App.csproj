<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>conclave</AssemblyName>
    <RootNamespace>Conclave.App</RootNamespace>
    <!--
      绑定在编译期解析（配合每个模板上的 x:DataType）。
      反射绑定绑不上时不报错，只是那个按钮点了没反应、那一格永远空着 —— 这类错误
      要等有人在真机上点到才发现。打开之后写错属性名直接是 AVLN2000 编译失败。
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      评审 skill 随包分发。评审子进程用 plugin-dir 参数装载它（见 ReviewSkillDeployer），
      于是任何节点都能评审，不必事先往 ~/.claude/skills 里铺东西；skill 的版本也就跟
      app 的版本绑死了 —— 出票契约（回复末尾那个 json 围栏）同时写在 skill 和
      ClaudeReviewRunner.CollectPrompt 里，两边漂移会静默出错。
    -->
    <None Include="review-plugin/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Conclave.Application/Conclave.Application.csproj" />
    <ProjectReference Include="../Conclave.Domain/Conclave.Domain.csproj" />
    <ProjectReference Include="../Conclave.Infrastructure/Conclave.Infrastructure.csproj" />
  </ItemGroup>

</Project>
